      "parameters": {
        "jsCode": "\nreturn items.map(item => {\n  // Parse the JSON string inside the text field\n  const data = typeof item.json.text === 'string'\n    ? JSON.parse(item.json.text)\n    : item.json.text;\n\n  // Clean the data\n  const cleaned = {\n    Student_ID: data.Student_ID?.trim() || null,\n    Name: data.Name?.trim() || null,\n    Email: data.Email?.trim().toLowerCase() || null,\n    Phone: data.Phone === 'NA' ? null : data.Phone?.trim() || null,\n    Course: data.Course?.trim() || null,\n    Fee_Paid: data.Fee_Paid,\n    City: data.City?.trim() || null,\n    Enrolled_Date: data.Enrolled_Date,\n    Email_Valid: data.Email_Valid\n  };\n\n  return { json: cleaned };\n});\n"
