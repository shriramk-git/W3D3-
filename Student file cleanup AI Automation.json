    {
      "parameters": {
        "promptType": "define",
        "text": "=clean this student enrollment row and return ONLY a JSON object\n\nRow data : {{ JSON.stringify($json) }}\n\nRUles:\n- Name : Title case (Manoj K)\n- Email : if invalid set INVALD_EMAIL\n- Phone : If less than 10 difits, set NA\n- Course : Only Python or Machine learning or Data Science\n- Fee Paid : Yes/YES - True, no/NO - False\n-City : Title case, Empty - NA\n- Enrolled_data : COnvert to YYYY-MM-DD\n\nReturn only raw JSON . No explnation. No markdown",
        "hasOutputParser": true,
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
